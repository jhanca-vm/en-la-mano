---
import prisma from '@/lib/prisma'
import CMSLayout from '@/layouts/CMSLayout.astro'
import Table from '@/components/Table.astro'

const page = Number(Astro.url.searchParams.get('page')) || 1
const skip = (page - 1) * 15
const [count, users] = await Promise.all([
  prisma.user.count(),
  prisma.user.findMany({ orderBy: { updatedAt: 'desc' }, take: 15, skip })
])
---

<CMSLayout>
  <section class="my-16">
    <a
      class:list={[
        'mb-4 px-5 py-2 w-fit block  rounded-full bg-orange-500',
        'text-neutral-100 hover:bg-orange-500/90'
      ]}
      href="/leads.csv"
      download
    >
      Descargar
    </a>
    <Table users={users} />
    <div
      class:list={[
        'py-5 flex flex-wrap-reverse items-center justify-between gap-4',
        'border-t border-t-neutral-400 font-display text-sm text-purple-900'
      ]}
    >
      <p>
        Mostrando del {skip + 1} al {15 * page} de {count} resultados
      </p>
      <nav>
        {
          Array.from({ length: Math.ceil(count / 15) }, (_, i) => (
            <a
              href={i + 1 === page ? undefined : `?page=${i + 1}`}
              class:list={[
                i + 1 === page
                  ? 'bg-purple-900 border-purple-900 text-neutral-100 ' +
                    'cursor-default'
                  : 'border-neutral-400 hover:bg-neutral-300/50',
                'py-0.5 px-2 border font-medium not-first:border-l-0',
                'first:rounded-l last:rounded-r'
              ]}
            >
              {i + 1}
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</CMSLayout>
