---
import { format, parse } from '@formkit/tempo'
import prisma from '@/lib/prisma'
import CMSLayout from '@/layouts/CMSLayout.astro'
import DownloadCSV from '@/components/DownloadCSV'

const token = Astro.cookies.get('token')!.value
const users = await prisma.user.findMany({
  orderBy: { updatedAt: 'desc' },
  take: 50
})
---

<CMSLayout>
  <section class="my-16">
    <DownloadCSV token={token} users={users} client:load />
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="text-left *:py-2 *:px-4 *:font-medium *:truncate">
            <th></th>
            <th></th>
            <th></th>
            <th>Cédula</th>
            <th>Celular</th>
            <th>Nacimiento</th>
            <th>Actividad laboral</th>
            <th>Ingreso al trabajo actual</th>
            <th>Salario</th>
          </tr>
        </thead>
        <tbody>
          {
            users.map((user) => (
              <tr
                class:list={[
                  'border-t border-neutral-400 font-light *:py-2 *:px-4',
                  '*:truncate'
                ]}
              >
                <td>
                  {user.result ? (
                    <span
                      class:list={[
                        'px-2 rounded-md border border-purple-500 font-normal',
                        'text-purple-500'
                      ]}
                    >
                      {user.result}
                    </span>
                  ) : (
                    '✅'
                  )}
                </td>
                <td>
                  <p class="font-normal">{user.source}</p>
                  <p class="text-purple-900 ">
                    {format(user.updatedAt, 'medium', 'es-UY')}
                  </p>
                </td>
                <td>
                  <p class="font-normal">
                    {user.firstName} {user.lastName}
                  </p>
                  <p class="text-purple-900">{user.email}</p>
                </td>
                <td>{user.docNumber}</td>
                <td>{user.mobilephone}</td>
                <td>
                  {user.dateOfBirth &&
                    parse(user.dateOfBirth, 'DD/MM/YYYY').toLocaleDateString(
                      'es-UY',
                      { dateStyle: 'medium' }
                    )}
                </td>
                <td>{user.activityType}</td>
                <td>
                  {user.workStartDate &&
                    parse(user.workStartDate, 'DD/MM/YYYY').toLocaleDateString(
                      'es-UY',
                      { dateStyle: 'medium' }
                    )}
                </td>
                <td>
                  {user.salary &&
                    new Intl.NumberFormat('es-UY', {
                      style: 'currency',
                      currency: 'UYU',
                      maximumFractionDigits: 0
                    }).format(Number(user.salary))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</CMSLayout>
