---
import { db, eq, Page } from 'astro:db'
import CMSLayout from '@/layouts/CMSLayout.astro'
import Textarea from '@/components/Textarea'

interface Data {
  mission: string
  vision: string
  values: string
  title: string
  description: string
}

const pattern = '/quienes-somos'
const [result] = await db.select().from(Page).where(eq(Page.pattern, pattern))
const data = result.data as Data
console.log(data)
---

<CMSLayout pattern={pattern}>
  <div class="lg:columns-2 lg:gap-6">
    <Textarea
      className="mb-6 break-inside-avoid"
      label="Misión"
      name="mission"
      defaultValue={data.mission}
    />
    <Textarea
      className="mb-6 break-inside-avoid"
      label="Visión"
      name="vision"
      defaultValue={data.vision}
    />
    <Textarea
      className="mb-6 break-inside-avoid"
      label="Valores"
      name="values"
      defaultValue={data.values}
    />
  </div>
</CMSLayout>
