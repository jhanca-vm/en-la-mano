---
import { actions } from 'astro:actions'
import { Admin, db } from 'astro:db'
import paseto from 'paseto'
import { publicKey } from '@/lib/keys'
import AuthLayout from '@/layouts/AuthLayout.astro'

const result = Astro.getActionResult(actions.signIn)

if (result && !result.error) return Astro.redirect('/admin')

const [admin] = await db.select().from(Admin)

if (admin === undefined) return Astro.rewrite('/admin/signup')

const token = Astro.cookies.get('token')

if (token) {
  try {
    await paseto.V4.verify(token.value, publicKey)
    return Astro.redirect('/admin')
  } catch {}
}
---

<AuthLayout
  title="Inicia Sesión"
  submitLabel="Iniciar Sesión"
  action={actions.signIn}
  error={result?.error.message}
/>
