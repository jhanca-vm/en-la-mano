---
import CMSLayout from '@/layouts/CMSLayout.astro'
import Textarea from '@/components/Textarea'
import Input from '@/components/Input'
import LandingList from '@/components/LandingList'
---

<CMSLayout>
  <section class="lg:grid lg:grid-cols-2 lg:gap-6">
    <Textarea label="Oferta" target="data.offer" client:load />
    <Textarea label="Requisitos" target="data.requirements" client:load />
    <Input type="url" label="Video" target="data.video" client:load />
  </section>
  <LandingList client:load />
</CMSLayout>
