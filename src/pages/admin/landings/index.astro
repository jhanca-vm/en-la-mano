---
import { db, eq, Page } from 'astro:db'
import CMSLayout from '@/layouts/CMSLayout.astro'
import Textarea from '@/components/Textarea'
import Input from '@/components/Input'
import List from './_List'

interface Data {
  offer: string
  video: string
  requirements: string
  landings: Array<{ name: string; bannerText: string }>
}

const pattern = '/landings'
const [result] = await db.select().from(Page).where(eq(Page.pattern, pattern))
const data = result.data as Data
---

<CMSLayout pattern={pattern}>
  <div class="lg:columns-2 lg:gap-6">
    <Textarea
      className="mb-6 break-inside-avoid"
      label="Oferta"
      name="offer"
      defaultValue={data.offer}
    />
    <Input
      className="mb-6 break-inside-avoid"
      type="url"
      label="Video"
      name="video"
      defaultValue={data.video}
    />
    <Textarea
      className="mb-6 break-inside-avoid"
      label="Requisitos"
      name="requirements"
      defaultValue={data.requirements}
    />
  </div>
  <List landings={data.landings} client:load />
</CMSLayout>
