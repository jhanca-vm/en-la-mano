---
import CMSLayout from '@/layouts/CMSLayout.astro'
import InputImage from '@/components/InputImage'
import Input from '@/components/Input'
import Textarea from '@/components/Textarea'
---

<CMSLayout>
  <section class="mb-12 grid gap-6 lg:grid-cols-2">
    <InputImage label="Logo" name="logo" client:idle />
    <InputImage
      class="bg-blue-950"
      label="Logo Blanco"
      name="logo-white"
      client:idle
    />
    <Input type="text" label="Facebook" target="data.facebook" client:load />
    <Input type="text" label="Instagram" target="data.instagram" client:load />
    <Textarea
      label="Descripción del formulario"
      target="data.formDescription"
      client:load
    />
  </section>
</CMSLayout>
