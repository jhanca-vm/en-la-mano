---
import { db, eq, Page } from 'astro:db'
import prisma from '@/lib/prisma'
import CMSLayout from '@/layouts/CMSLayout.astro'
import InputImage from '@/components/InputImage'
import Input from '@/components/Input'
import Textarea from '@/components/Textarea'
import Table from '@/components/Table.astro'

interface Data {
  facebook: string
  instagram: string
  formDescription: string
}

const page = Number(Astro.url.searchParams.get('page')) || 1
const skip = (page - 1) * 7
const pattern = '*'

const [[result], count, users] = await Promise.all([
  db.select().from(Page).where(eq(Page.pattern, pattern)),
  prisma.user.count(),
  prisma.user.findMany({ orderBy: { updatedAt: 'desc' }, take: 7, skip })
])

const data = result.data as Data
---

<CMSLayout pattern={pattern}>
  <div class="mb-12 grid gap-6 lg:grid-cols-2">
    <InputImage label="Logo" name="logo" client:idle />
    <InputImage
      className="bg-blue-950"
      label="Logo Blanco"
      name="logo-white"
      client:idle
    />
    <Input
      type="text"
      label="Facebook"
      name="facebook"
      defaultValue={data.facebook}
    />
    <Input
      type="text"
      label="Instagram"
      name="instagram"
      defaultValue={data.instagram}
    />
    <Textarea
      className="lg:col-span-2"
      label="Descripción del formulario"
      name="formDescription"
      defaultValue={data.formDescription}
    />
  </div>
  <section slot="widgets" class="my-18">
    <Table users={users} />
    <div
      class:list={[
        'py-5 flex flex-wrap-reverse items-center justify-between gap-4',
        'border-t border-t-neutral-400 font-display text-sm text-purple-900'
      ]}
    >
      <p>
        Mostrando del {skip + 1} al {7 * page} de {count} resultados
      </p>
      <nav>
        {
          Array.from({ length: Math.ceil(count / 7) }, (_, i) => (
            <a
              href={i + 1 === page ? undefined : `?page=${i + 1}`}
              class:list={[
                i + 1 === page
                  ? 'bg-purple-900 border-purple-900 text-neutral-100 ' +
                    'cursor-default'
                  : 'border-neutral-400 hover:bg-neutral-300/50',
                'py-0.5 px-2 border font-medium not-first:border-l-0',
                'first:rounded-l last:rounded-r'
              ]}
            >
              {i + 1}
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</CMSLayout>
