---
import CMSLayout from '@/layouts/CMSLayout.astro'
import InputImage from '@/components/InputImage'
import Input from '@/components/Input'
import Textarea from '@/components/Textarea'
---

<CMSLayout>
  <section class="lg:grid lg:grid-cols-2 lg:gap-x-6">
    <InputImage label="Logo" name="logo" client:idle />
    <InputImage
      class="bg-blue-950"
      label="Logo Blanco"
      name="logo-white"
      client:idle
    />
    <Input
      class="mb-6 break-inside-avoid"
      type="text"
      label="Facebook"
      target="data.facebook"
      client:load
    />
    <Input
      class="mb-6 break-inside-avoid"
      type="text"
      label="Instagram"
      target="data.instagram"
      client:load
    />
    <Textarea
      label="Descripción del formulario"
      target="data.formDescription"
      client:load
    />
  </section>
</CMSLayout>
