---
import paseto from 'paseto'
import { db, eq, Page } from 'astro:db'
import { publicKey } from '@/keys'
import SiteLayout from '@/layouts/SiteLayout.astro'
import FormComponent from '@/components/Form'

interface Data {
  formDescription: string
}

let data: Data
let docNumber: string

try {
  const { sub } = await paseto.V4.verify(
    Astro.url.searchParams.get('token') || '',
    publicKey
  )

  const [result] = await db.select().from(Page).where(eq(Page.pattern, '*'))

  data = result.data as Data
  docNumber = sub as string
} catch {
  return Astro.redirect('/')
}
---

<SiteLayout>
  <section
    class:list={[
      'mt-12 px-5 flex flex-col gap-16 sm:px-10 md:px-20 lg:flex-row',
      'lg:justify-center'
    ]}
  >
    <div class="lg:basis-50 xl:basis-67">
      <h1 class="font-bold text-4xl">
        Completá <span class="block sm:inline lg:block">tus datos</span>
      </h1>
      <p class="mt-8 font-light leading-snug">{data.formDescription}</p>
    </div>
    <FormComponent docNumber={docNumber} client:idle />
  </section>
</SiteLayout>
