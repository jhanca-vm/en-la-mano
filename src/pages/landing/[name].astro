---
import { db, eq, Page } from 'astro:db'
import { marked } from 'marked'
import SiteLayout from '@/layouts/SiteLayout.astro'
import LandingHero from '@/components/LandingHero.astro'
import LandingForm from '@/components/LandingForm'
import Steps from '@/components/Steps.astro'
import liteYoutubeEmbed from 'lite-youtube-embed/src/lite-yt-embed?url'
import 'lite-youtube-embed/src/lite-yt-embed.css'

interface Data {
  offer: string
  requirements: string
  video: string
  landings: { name: string; bannerText: string }[]
}

const { name } = Astro.params

const [result] = await db
  .select()
  .from(Page)
  .where(eq(Page.pattern, '/landings'))

const data = result.data as Data
const landing = data.landings.find((landing) => landing.name === name)

if (!landing) return Astro.rewrite('/404')

const requirements = await marked.parse(data.requirements)
const videoid = new URL(data.video).searchParams.get('v')
---

<SiteLayout>
  <LandingHero name={name!} bannerText={landing.bannerText}>
    <LandingForm source={name!} client:idle>
      <Fragment set:html={marked.parse(data.offer, { breaks: true })} />
    </LandingForm>
  </LandingHero>
  <section class="my-20 md:my-25">
    <Steps>
      <Fragment
        set:html={requirements.replace(
          '<ul>',
          '<ul class="max-w-5xl justify-self-center mx-5 pl-4.5 list-disc ' +
            'font-light leading-tight marker:text-orange-500 *:mb-4 ' +
            'sm:columns-2 sm:gap-17 md:columns-3 md:mx-10">'
        )}
      />
    </Steps>
  </section>
  <section class="mb-28 px-5 md:px-10">
    <lite-youtube class="inset-x-0 mx-auto rounded-3xl" videoid={videoid}
    ></lite-youtube>
  </section>
</SiteLayout>

<script is:inline src={liteYoutubeEmbed}></script>
