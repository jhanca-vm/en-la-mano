---
import paseto from 'paseto'
import { publicKey } from '@/lib/keys'
import SiteLayout from '@/layouts/SiteLayout.astro'

interface Data {
  formDescription: string
}

let result: string | null

try {
  const payload = await paseto.V4.verify(
    Astro.url.searchParams.get('token') || '',
    publicKey
  )

  result = payload.result as string | null
} catch {
  return Astro.redirect('/')
}
---

<SiteLayout>
  <section
    class="max-w-3xl m-auto px-10 pt-12 pb-24 text-center md:px-20 md:pb-32"
  >
    <h1 class="mb-10 text-4xl/tight text-orange-500 text-pretty">
      {
        result === null
          ? 'Tu préstamo está casi pronto'
          : result === 'Pre-Lead Repetido rechazado' ||
              result === 'Lead Repetido rechazado'
            ? 'Ya estamos trabajando en tu solicitud'
            : 'En este momento no podemos ofrecerte un préstamo'
      }
    </h1>
    <p class="font-light text-lg">
      {
        !result
          ? 'Estamos analizando los detalles y podemos ofrecerte un ' +
            'préstamo. En breve te contactaremos para que sigas avanzando. ' +
            '¡Quedate atento!'
          : result === 'Pre-Lead Repetido rechazado' ||
              result === 'Lead Repetido rechazado'
            ? 'Tenemos tus datos y estamos analizando tu perfil. Pronto te ' +
              'daremos una respuesta para ofrecerte el SÍ que necesitás. ' +
              '¡Gracias por tu paciencia!'
            : 'Por ahora no contamos con una opción que se ajuste a tus ' +
              'necesidades, pero no te preocupes: nuestros asesores seguirán ' +
              'evaluando tu perfil para ofrecerte pronto el Sí que estás ' +
              'buscando.'
      }
    </p>
  </section>
</SiteLayout>
