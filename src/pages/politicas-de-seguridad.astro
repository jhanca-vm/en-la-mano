---
import { db, eq, Page } from 'astro:db'
import { marked } from 'marked'
import SiteLayout from '@/layouts/SiteLayout.astro'

interface Data {
  content: string
}

const { pathname } = Astro.url
const [result] = await db.select().from(Page).where(eq(Page.pattern, pathname))
const { content } = result.data as Data
---

<SiteLayout>
  <section class="max-w-prose mt-12 mb-24 mx-5 self-center">
    <h1 class="mb-12 font-semibold text-center text-4xl">
      Políticas de Seguridad
    </h1>
    <div class="prose" set:html={marked.parse(content)} />
  </section>
</SiteLayout>
