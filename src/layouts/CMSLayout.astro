---
import Sidebar from '@/components/Sidebar'
import Button from '@/components/Button'
import BaseLayout from './BaseLayout.astro'

interface Props {
  pattern?: string
}

const { pattern } = Astro.props
---

<BaseLayout class="bg-neutral-100 text-blue-900 md:flex">
  <Sidebar
    pathname={Astro.url.pathname}
    username={Astro.locals.username}
    client:load
  />
  <main class="overflow-x-hidden px-4 grow md:px-8">
    {
      pattern ? (
        <form id="main">
          <Button
            className="sticky top-4 mt-4 mb-6 ml-auto block shadow-lg"
            disabled
          >
            Guardar
          </Button>
          <input type="hidden" name="pattern" value={pattern} />
          <div class="max-w-sm mx-auto lg:max-w-3xl">
            <slot />
          </div>
        </form>
      ) : (
        <slot />
      )
    }
    <slot name="outside" />
  </main>
</BaseLayout>

<script>
  import { actions } from 'astro:actions'

  const form = document.querySelector<HTMLFormElement>('form#main')

  if (form) {
    const button = form.querySelector('button')!
    const elements = form.querySelectorAll<
      HTMLInputElement | HTMLTextAreaElement
    >('input[name], textarea')

    for (const element of elements) {
      element.oninput = () => (button.disabled = false)
    }

    button.onclick = () => {
      form.className += ' opacity-75 pointer-events-none animate-pulse'
      button.className += ' bg-orange-500/neutral-100'
    }

    form.onsubmit = (event) => {
      event.preventDefault()
      actions.setData(Object.fromEntries(new FormData(form)))
    }
  }
</script>
