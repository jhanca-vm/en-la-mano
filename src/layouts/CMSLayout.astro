---
import { db, eq, Image, Page } from 'astro:db'
import Sidebar from '@/components/Sidebar'
import Content from '@/components/Content'
import BaseLayout from './BaseLayout.astro'

const { pathname } = Astro.url
const pattern = pathname.split('admin')[1] || '*'
const [initialState] = await db
  .select()
  .from(Page)
  .where(eq(Page.pattern, pattern))
---

<BaseLayout class="bg-neutral-100 text-blue-900 md:flex">
  <Sidebar pathname={pathname} client:media="(width < 768px)" />
  <Content
    initialState={JSON.stringify(initialState || { pattern, data: {} })}
    client:load
  >
    <slot />
  </Content>
</BaseLayout>
