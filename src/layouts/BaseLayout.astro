---
import '@fontsource-variable/outfit'
import '@fontsource-variable/manrope'

interface Props {
  class?: string
  title?: string
}

const { class: className, title } = Astro.props
const siteName = 'En La Mano'
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${siteName}` : siteName}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <slot name="head" />
  </head>
  <body class:list={['min-h-svh', className]}>
    <slot />
  </body>
</html>

<style is:global>
  @import 'tailwindcss';

  @theme {
    --font-sans: 'Outfit Variable', sans-serif;
    --font-display: 'Manrope Variable', sans-serif;
    --text-4xl: 2.5rem;
    --color-blue-900: oklch(0.194 0.1221 270.13);
    --color-blue-950: oklch(0.1887 0.1187 269.74);
    --color-neutral-100: oklch(0.9672 0 0);
    --color-neutral-300: oklch(0.8421 0 0);
    --color-neutral-400: oklch(0.683 0 0);
    --color-orange-500: oklch(0.7103 0.1959 47.16);
    --color-purple-500: oklch(0.6489 0.2659 313.53);
    --color-purple-900: oklch(0.3203 0.1623 296.68);
  }

  @layer base {
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    input[type='number'] {
      -moz-appearance: textfield;
    }
  }

  @layer components {
    .prose {
      font-weight: 300;
      & > :where(:not(:last-child)) {
        margin-block: calc(var(--spacing) * 4);
      }
      h2 {
        font-size: var(--text-lg);
        font-weight: 600;
        line-height: var(--text-lg--line-height);
        margin-top: calc(var(--spacing) * 10);
      }
      ul {
        list-style-type: disc;
        padding-left: calc(var(--spacing) * 5);
      }
      li {
        margin-block: calc(var(--spacing) * 2);
        &::marker {
          color: var(--color-orange-500);
        }
      }
      a {
        font-weight: 400;
        color: var(--color-purple-500);
        text-decoration-line: underline;
      }
      strong {
        font-weight: 500;
      }
    }
  }

  @utility bg-orange-500/neutral-100 {
    background-color: color-mix(
      in oklab,
      var(--color-orange-500) 45%,
      var(--color-neutral-100)
    );
  }
</style>
