---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Input from '@/components/Input'
import Button from '@/components/Button'

interface Props {
  title: string
  submitLabel: string
  action: string
  error?: string
}

const { title, action, submitLabel, error } = Astro.props
---

<BaseLayout
  class:list={[
    'py-12 px-6 flex flex-col items-center justify-center bg-neutral-100',
    'text-blue-900'
  ]}
>
  <Image class="w-12" src="/favicon.png" alt="" width="48" height="48" />
  <h1 class="mt-5 mb-10 font-semibold text-4xl">{title}</h1>
  <form class="max-w-sm w-full mb-10 space-y-4" method="POST" action={action}>
    <Input name="username" placeholder="Usuario" />
    <Input type="password" name="password" placeholder="Contraseña" />
    {error && <p class="text-right text-sm text-red-500">{error}</p>}
    <Button className="w-full">{submitLabel}</Button>
  </form>
</BaseLayout>
