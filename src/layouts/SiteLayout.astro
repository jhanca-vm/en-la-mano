---
import { db, eq, Page } from 'astro:db'
import { Image } from 'astro:assets'
import unit from '@/assets/unit.webp'
import whatsapp from '@/assets/whatsapp.webp'
import IconMobile from '@/components/icons/Mobile.astro'
import IconPhone from '@/components/icons/Phone.astro'
import IconMail from '@/components/icons/Mail.astro'
import Nav from '@/components/Nav'
import SocialMedia from '@/components/SocialMedia.astro'
import BaseLayout from './BaseLayout.astro'

interface Props {
  class?: string
}

interface Data {
  facebook: string
  instagram: string
}

const { pathname, origin } = Astro.url
const isLanding = pathname === '/' || pathname.startsWith('/landing/')
const [result] = await db.select().from(Page).where(eq(Page.pattern, '*'))
const data = result.data as Data
---

<BaseLayout
  class:list={[
    'flex flex-col bg-linear-108 from-purple-500 from-[-18.5%] via-purple-900',
    'via-34% to-blue-950 to-[88.5%] text-neutral-100'
  ]}
>
  <header
    class:list={[
      Astro.props.class,
      { 'sticky top-0 md:-top-4': isLanding },
      'inset-x-0 z-10 flex'
    ]}
  >
    <div
      class:list={[
        { 'rounded-full shadow-2xl bg-neutral-100 text-blue-900': isLanding },
        'w-full m-5 py-2.5 px-5 flex items-center justify-between md:mx-10',
        'md:my-8 md:px-10 xl:mx-15'
      ]}
    >
      <Image
        class="w-auto h-12"
        src={`${origin}/images/${isLanding ? 'logo' : 'logo-white'}`}
        alt="Préstamos - En La Mano"
        inferSize
      />
      <Nav
        pathname={pathname}
        isLanding={isLanding}
        client:media="(width < 768px)"
      />
      <SocialMedia
        class={isLanding ? 'text-purple-900' : 'text-neutral-100'}
        facebook={data.facebook}
        instagram={data.instagram}
      />
    </div>
  </header>
  <main class="grow flex flex-col">
    <slot />
  </main>
  <footer
    class:list={[
      'px-5 py-15 flex flex-col gap-15 bg-linear-88 from-neutral-300',
      'from-[-19.5%] to-neutral-100 to-[122.5%] text-blue-900 sm:flex-row',
      'sm:justify-between md:px-10 lg:px-20 xl:px-25'
    ]}
  >
    <nav
      class:list={[
        'flex flex-col items-center gap-3 *:underline *:hover:text-purple-900',
        'sm:items-start xl:grid xl:grid-cols-2 xl:gap-x-15'
      ]}
    >
      <a href="/terminos-y-condiciones">Términos y Condiciones</a>
      <a class="xl:row-start-2" href="/preguntas-frecuentes">
        Preguntas frecuentes
      </a>
      <a href="/politicas-de-privacidad">Políticas de Privacidad</a>
      <a href="/politicas-de-seguridad">Políticas de Seguridad </a>
      <a href="/reclamos">Reclamos</a>
    </nav>
    <section
      class:list={[
        'h-fit flex flex-col items-center gap-3 font-light sm:items-end',
        'xl:grid xl:grid-cols-2 xl:gap-x-0'
      ]}
    >
      <figure class="flex items-center gap-2">
        <IconMobile class="text-purple-900" />
        <figcaption>(+598) 091 866 454</figcaption>
      </figure>
      <figure class="flex items-center gap-2 xl:row-start-2">
        <IconPhone class="text-purple-900" />
        <figcaption>(+598) 2605 4699</figcaption>
      </figure>
      <div class="flex items-center gap-2">
        <IconMail class="text-purple-900" />
        <a class="hover:underline" href="mailto:contacto@enlamano.com.uy">
          contacto@enlamano.com.uy
        </a>
      </div>
      <SocialMedia
        class="text-purple-900"
        facebook={data.facebook}
        instagram={data.instagram}
      />
    </section>
  </footer>
  <div
    class:list={[
      'fixed bottom-5 right-5 flex gap-3 *:hover:scale-105 md:right-10',
      'xl:right-15'
    ]}
  >
    <a href="/normas-unit" target="_blank">
      <Image class="w-13" src={unit} alt="Normas UNIT" />
    </a>
    <a href="https://wa.me/59891866565" target="_blank" rel="noreferrer">
      <Image class="w-13" src={whatsapp} alt="WhatsApp" />
    </a>
  </div>
</BaseLayout>
