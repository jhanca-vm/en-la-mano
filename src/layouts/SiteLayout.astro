---
import { db, eq, Page } from 'astro:db'
import { Image } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import LoadingIndicator from 'astro-loading-indicator/component'
import unit from '@/assets/unit.webp'
import whatsapp from '@/assets/whatsapp.webp'
import Nav from '@/components/Nav'
import SocialMedia from '@/components/SocialMedia.astro'
import Footer from '@/components/Footer.astro'
import BaseLayout from './BaseLayout.astro'

interface Props {
  class?: string
  title?: string
}

interface Data {
  facebook: string
  instagram: string
}

const { pathname, origin } = Astro.url
const { class: className, title } = Astro.props
const isLanding = pathname === '/' || pathname.startsWith('/landing/')
const [result] = await db.select().from(Page).where(eq(Page.pattern, '*'))
const data = result.data as Data
---

<BaseLayout
  class:list={[
    'flex flex-col bg-linear-108 from-purple-500 from-[-18.5%] via-purple-900',
    'via-34% to-blue-950 to-[88.5%] text-neutral-100'
  ]}
  title={title}
>
  <Fragment slot="head">
    <script is:inline>
      ;(function (w, d, s, l, i) {
        w[l] = w[l] || []
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : ''
        j.async = true
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
        f.parentNode.insertBefore(j, f)
      })(window, document, 'script', 'dataLayer', 'GTM-N83S3S2V')
    </script>
    <ClientRouter />
    <LoadingIndicator color="var(--color-orange-500)" />
  </Fragment>
  <noscript>
    <iframe
      src="https://www.googletagmanager.com/ns.html?id=GTM-N83S3S2V"
      height="0"
      width="0"
      style="display:none;visibility:hidden"></iframe>
  </noscript>
  <header
    class:list={[
      className,
      { 'sticky top-0 md:-top-4': isLanding },
      'inset-x-0 z-10 flex'
    ]}
  >
    <div
      class:list={[
        { 'rounded-full shadow-xl bg-neutral-100 text-blue-900': isLanding },
        'w-full m-5 py-2.5 px-5 flex items-center justify-between md:mx-10',
        'md:my-8 md:px-10 xl:mx-15'
      ]}
    >
      <Image
        class="w-auto h-12"
        src={`${origin}/images/${isLanding ? 'logo' : 'logo-white'}`}
        alt="Préstamos - En La Mano"
        inferSize
      />
      <Nav
        pathname={pathname}
        isLanding={isLanding}
        client:media="(width < 1024px)"
      />
      <SocialMedia
        class={isLanding ? 'text-purple-900' : 'text-neutral-100'}
        facebook={data.facebook}
        instagram={data.instagram}
      />
    </div>
  </header>
  <main class="grow flex flex-col">
    <slot />
  </main>
  <Footer facebook={data.facebook} instagram={data.instagram} />
  <div
    class:list={[
      'fixed bottom-2.5 right-5 flex gap-2.5 *:hover:scale-105 md:right-10',
      'xl:right-15'
    ]}
  >
    <a href="/normas-unit">
      <Image class="w-12" src={unit} alt="Normas UNIT" />
    </a>
    <a href="https://wa.me/59891866565" target="_blank" rel="noreferrer">
      <Image class="w-12" src={whatsapp} alt="WhatsApp" />
    </a>
  </div>
</BaseLayout>
