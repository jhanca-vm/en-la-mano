---
const list = [
  {
    icon: 'pencil',
    width: '34',
    height: '34',
    description: 'Ingresá tu cédula y número de celular'
  },
  {
    icon: 'check-white',
    width: '34',
    height: '28',
    description: 'Completá el formulario y recibí la aprobación'
  },
  {
    icon: 'wallet',
    width: '36',
    height: '36',
    description: '¡Ya podés retirar el dinero!'
  }
]
---

<h2 class="mb-12 font-light text-center text-4xl text-pretty">
  Tu préstamo en <strong class="font-bold text-purple-500">3 pasos</strong>
</h2>
<ol class="flex flex-col items-center justify-center text-center lg:flex-row">
  {
    list.map(({ icon, description, ...size }, index) => (
      <>
        {index !== 0 && (
          <li class="m-10 lg:mt-0 lg:mb-16" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-2 fill-none stroke-purple-500 rotate-90 lg:rotate-0"
              viewBox="0 0 6 12"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M.5 1s5 3.682 5 5-5 5-5 5"
              />
            </svg>
          </li>
        )}
        <li>
          <figure
            class:list={[
              'mx-auto size-[76px] grid place-items-center rounded-full ring',
              'ring-purple-500'
            ]}
          >
            <img src={`/icons/${icon}.svg`} alt="" {...size} loading="lazy" />
          </figure>
          <p class="mt-4 w-48 font-light text-lg/tight text-pretty">
            {description}
          </p>
        </li>
      </>
    ))
  }
</ol>
<h3 class="mt-20 mb-10 font-semibold text-center text-2xl">Requisitos</h3>
<slot />
