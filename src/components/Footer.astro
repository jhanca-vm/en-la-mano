---
import IconMobile from '@/components/icons/Mobile.astro'
import IconPhone from '@/components/icons/Phone.astro'
import IconMail from '@/components/icons/Mail.astro'
import IconClock from '@/components/icons/Clock.astro'
import SocialMedia from '@/components/SocialMedia.astro'

interface Props {
  facebook: string
  instagram: string
}

const { facebook, instagram } = Astro.props
---

<footer
  class:list={[
    'px-5 py-15 flex flex-col gap-15 bg-linear-88 from-neutral-300',
    'from-[-19.5%] to-neutral-100 to-[122.5%] text-blue-900 sm:flex-row',
    'sm:justify-between md:px-10 lg:px-20 xl:px-25'
  ]}
>
  <nav
    class:list={[
      'flex flex-col items-center gap-3 *:underline *:hover:text-purple-900',
      'sm:items-start xl:grid xl:grid-cols-2 xl:gap-x-15'
    ]}
  >
    <a href="/terminos-y-condiciones">Términos y Condiciones</a>
    <a class="xl:row-start-2" href="/preguntas-frecuentes">
      Preguntas frecuentes
    </a>
    <a href="/politicas-de-privacidad">Políticas de Privacidad</a>
    <a href="/politicas-de-seguridad">Políticas de Seguridad </a>
    <a href="/reclamos">Reclamos</a>
    <a href="/bases-y-condiciones-de-sorteos">Bases y Condiciones de Sorteos</a>
  </nav>
  <section
    class:list={[
      'h-fit flex flex-col items-center gap-3 font-light sm:items-end xl:grid ',
      'xl:grid-cols-2 xl:gap-x-0'
    ]}
  >
    <figure class="grid items-center gap-2">
      <IconMobile class="justify-self-center text-purple-900" />
      <figcaption>(+598) 091 866 454</figcaption>
    </figure>
    <figure class="grid items-center gap-2 xl:row-start-2">
      <IconPhone class="justify-self-center text-purple-900" />
      <figcaption>(+598) 2605 4699</figcaption>
    </figure>
    <div class="grid items-center gap-2">
      <IconMail class="justify-self-center text-purple-900" />
      <a class="hover:underline" href="mailto:contacto@enlamano.com.uy">
        contacto@enlamano.com.uy
      </a>
    </div>
    <SocialMedia
      class="order-5 text-purple-900 xl:order-none"
      facebook={facebook}
      instagram={instagram}
    />
    <figure class="grid items-center gap-2 xl:col-span-2">
      <IconClock class="justify-self-center mb-5 text-purple-900" />
      <figcaption>
        Lunes a Viernes de 9:00 a 18:00 hs.
        <span class="block">Sábados de 09:00 a 13:00 hs.</span>
      </figcaption>
    </figure>
  </section>
</footer>

<style>
  .grid {
    grid-template-columns: calc(var(--spacing) * 4.75) 1fr;
  }
</style>
