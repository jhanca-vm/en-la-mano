datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id
  docNumber     String
  mobilephone   String?
  source        String?
  result        String?
  firstName     String?
  lastName      String?
  activityType  String?
  salary        String?
  dateOfBirth   String?
  workStartDate String?
  email         String?
  createdAt     DateTime @default(now())
}

model Complaint {
  id          Int     @id @default(autoincrement())
  firstName   String?
  lastName    String?
  docNumber   String
  email       String
  mobilephone String
  phone       String?
  comments    String  @db.LongText
}
